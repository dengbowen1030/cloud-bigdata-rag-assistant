APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Local development SQLite database.
DATABASE_URL=sqlite:///../data/edurag.db

# Docker Compose local deployment overrides this value to:
# DATABASE_URL=sqlite:////app/data/edurag.db

# Deployment-only PostgreSQL example. Do not use for local Stage 2 development.
POSTGRES_DATABASE_URL=postgresql+psycopg2://edurag:edurag@postgres:5432/edurag

UPLOAD_DIR=uploads/raw
UPLOAD_RAW_DIR=uploads/raw
UPLOAD_PROCESSED_DIR=uploads/processed
PROCESSED_DIR=uploads/processed
UPLOAD_TEMP_DIR=uploads/temp
FAISS_INDEX_DIR=vector_store/faiss_index

RAG_EMBEDDING_MODE=real
RAG_EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
RAG_EMBEDDING_DOWNLOAD=0
VECTOR_STORE_DIR=vector_store/faiss_index
EMBEDDING_MODEL=bge-small-zh-v1.5
LLM_PROVIDER=deepseek

# Put real API keys in local .env only. Never commit .env or paste keys into docs.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
